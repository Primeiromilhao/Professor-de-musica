{
  "schemaVersion": "1.0",
  "title": "HERMES Violin Lab — Caminho Progressivo",
  "direction": "base_para_topo",
  "principle": "Paganini é destino curricular, não ponto de partida.",
  "gates": {
    "masteryMinimum": 0.80,
